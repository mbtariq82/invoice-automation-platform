# Copy to staging.tfvars and replace the project/image/model values before planning.
project_id                   = "your-staging-project-id"
region                       = "europe-west2"
name_prefix                  = "invoice-staging"
database_credentials_version = 1
openrouter_key_version       = 1
deploy_application           = false
container_image              = ""
deploy_frontend              = false
frontend_container_image     = ""
frontend_google_client_id    = ""
openrouter_model             = ""
invoker_members              = []
admin_members                = []
api_token_audiences          = [] # Set the service URL or an OAuth client ID before deploying.
