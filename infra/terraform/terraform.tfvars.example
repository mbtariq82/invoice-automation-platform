project_id = "your-gcp-project-id"
region     = "europe-west2"

# First apply: provision supporting resources before the container exists.
deploy_application = false

# After pushing an image, set its immutable digest and enable the application.
# container_image    = "europe-west2-docker.pkg.dev/your-gcp-project-id/invoice-dev-images/api@sha256:<64-character-digest>"
# vertex_ai_model   = "gemini-2.5-flash"
# deploy_application = true
# frontend_google_client_id = "your-client-id.apps.googleusercontent.com"
# invoker_members    = ["user:you@example.com"]
# admin_members      = ["user:you@example.com"]

# Secret Manager version numbers are metadata, not secret values.
database_credentials_version = 1
openrouter_key_version        = 1
