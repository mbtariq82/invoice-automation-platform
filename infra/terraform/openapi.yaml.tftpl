swagger: '2.0'
info:
  title: ${name_prefix} invoice API
  version: '1.0'
schemes:
  - https
produces:
  - application/json
x-google-backend:
  address: ${api_url}
  jwt_audience: ${api_url}
securityDefinitions:
  google_id_token:
    authorizationUrl: ''
    flow: implicit
    type: oauth2
    x-google-issuer: https://accounts.google.com
    x-google-jwks_uri: https://www.googleapis.com/oauth2/v3/certs
    x-google-audiences: ${oauth_client_id}
paths:
  /$${path=**}:
    parameters:
      - name: path
        in: path
        required: true
        type: string
    x-google-backend:
      address: ${api_url}
      jwt_audience: ${api_url}
    get:
      operationId: proxyGet
      security:
        - google_id_token: []
      responses:
        '200':
          description: Successful response
    post:
      operationId: proxyPost
      security:
        - google_id_token: []
      responses:
        '200':
          description: Successful response
